{
    "Keystone Squad List": {
        "prefix": [
            "/squad",
            "@squad"
        ],
        "body": [
            "/squad"
        ],
        "description": "Ver cartelera de especialistas activos del proyecto"
    },
    "Keystone Dev PHP": {
        "prefix": [
            "@dev-php",
            "@php"
        ],
        "body": [
            "@dev-php: ${1:implementa la lógica/endpoint para ...}"
        ],
        "description": "Invocar al especialista backend PHP"
    },
    "Keystone Dev Frontend": {
        "prefix": [
            "@dev-frontend",
            "@fe",
            "@ui"
        ],
        "body": [
            "@dev-frontend: ${1:diseña la interfaz y estilos responsivos para ...}"
        ],
        "description": "Invocar al especialista frontend y UI"
    },
    "Keystone Dev Salesforce": {
        "prefix": [
            "@dev-sf",
            "@salesforce"
        ],
        "body": [
            "@dev-salesforce: ${1:implementa la clase Apex / LWC para ...}"
        ],
        "description": "Invocar al especialista Salesforce Core y FSC"
    },
    "Keystone Dev OmniStudio": {
        "prefix": [
            "@omnistudio",
            "@flexcard",
            "@omniscript",
            "@ip"
        ],
        "body": [
            "@dev-omnistudio: ${1:diseña o refactoriza FlexCard, OmniScript o Integration Procedure para ...}"
        ],
        "description": "Invocar al especialista Salesforce OmniStudio declarativo y JSON"
    },
    "Keystone Correlativo Guardian": {
        "prefix": [
            "@correlative",
            "@sol"
        ],
        "body": [
            "@correlative-guardian: reserva el siguiente correlativo SOL para ${1:descripción del cambio}"
        ],
        "description": "Asignar correlativo atómico en CONTROL_CORRELATIVOS.md"
    },
    "Keystone QA Code Review": {
        "prefix": [
            "@qa",
            "@qa-code-reviewer"
        ],
        "body": [
            "@qa-code-reviewer: revisa los cambios recientes y verifica php -l y buenas prácticas"
        ],
        "description": "Auditoría de código pre-commit"
    },
    "Keystone Smoke Tester": {
        "prefix": [
            "@smoke",
            "@qa-smoke-tester"
        ],
        "body": [
            "@qa-smoke-tester: ejecuta smoke test HTTP 200 en ${1:https://qa.dominio.cl}"
        ],
        "description": "Validación de respuesta en vivo post-despliegue"
    },
    "Keystone SecOps Guardian": {
        "prefix": [
            "@secops",
            "@seguridad"
        ],
        "body": [
            "@secops-guardian: audita la seguridad, sanitización de inputs y blindaje contra OWASP"
        ],
        "description": "Auditoría de ciberseguridad y 2FA"
    },
    "Keystone DB Migration": {
        "prefix": [
            "@db",
            "@sql"
        ],
        "body": [
            "@db-migration-architect: diseña la migración SQL idempotente para ${1:nombre de tabla}"
        ],
        "description": "Diseño y optimización de esquemas relacionales"
    },
    "Keystone Release Manager": {
        "prefix": [
            "@release",
            "@deploy"
        ],
        "body": [
            "@release-manager: prepara el PR y la promoción de cambios desde develop hacia qa"
        ],
        "description": "Gestión de ramas Git, PRs y Quality Gates"
    }
}
