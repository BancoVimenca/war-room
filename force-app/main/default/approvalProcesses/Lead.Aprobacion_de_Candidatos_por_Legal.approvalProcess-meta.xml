<?xml version="1.0" encoding="UTF-8"?>
<ApprovalProcess xmlns="http://soap.sforce.com/2006/04/metadata">
    <active>true</active>
    <allowRecall>false</allowRecall>
    <allowedSubmitters>
        <type>owner</type>
    </allowedSubmitters>
    <approvalPageFields>
        <field>Name</field>
        <field>Company</field>
        <field>LEA_RNC__c</field>
        <field>LEA_Doc_Legal_No_Aprobada__c</field>
        <field>Status</field>
        <field>LEA_SubEstado__c</field>
        <field>LEA_Link_Candidato__c</field>
        <field>Owner</field>
    </approvalPageFields>
    <approvalStep>
        <allowDelegate>false</allowDelegate>
        <assignedApprover>
            <approver>
                <name>FSC_PLA</name>
                <type>queue</type>
            </approver>
            <whenMultipleApprovers>FirstResponse</whenMultipleApprovers>
        </assignedApprover>
        <label>Derivado a PLA</label>
        <name>Paso_1</name>
        <rejectionActions>
            <action>
                <name>Tec_Update_Status_Iniciado</name>
                <type>FieldUpdate</type>
            </action>
            <action>
                <name>Update_Resultado_Valida</name>
                <type>FieldUpdate</type>
            </action>
            <action>
                <name>Update_SubEstado</name>
                <type>FieldUpdate</type>
            </action>
        </rejectionActions>
    </approvalStep>
    <approvalStep>
        <allowDelegate>false</allowDelegate>
        <approvalActions>
            <action>
                <name>Actualizar_Estado</name>
                <type>FieldUpdate</type>
            </action>
            <action>
                <name>Limpiar_Documentos_Legales_Pendientes</name>
                <type>FieldUpdate</type>
            </action>
        </approvalActions>
        <assignedApprover>
            <approver>
                <name>FSC_Legal</name>
                <type>queue</type>
            </approver>
            <whenMultipleApprovers>FirstResponse</whenMultipleApprovers>
        </assignedApprover>
        <label>Derivado a Formalización</label>
        <name>Paso_2</name>
        <rejectBehavior>
            <type>RejectRequest</type>
        </rejectBehavior>
        <rejectionActions>
            <action>
                <name>Tec_Update_Status_Iniciado</name>
                <type>FieldUpdate</type>
            </action>
            <action>
                <name>Update_Resultado_Valida</name>
                <type>FieldUpdate</type>
            </action>
            <action>
                <name>Update_SubEstado</name>
                <type>FieldUpdate</type>
            </action>
        </rejectionActions>
    </approvalStep>
    <enableMobileDeviceAccess>false</enableMobileDeviceAccess>
    <entryCriteria>
        <formula>LEA_Doc_Legal_No_Aprobada__c &gt; 0</formula>
    </entryCriteria>
    <finalApprovalRecordLock>false</finalApprovalRecordLock>
    <finalRejectionActions>
        <action>
            <name>Tec_Update_Status_Iniciado</name>
            <type>FieldUpdate</type>
        </action>
        <action>
            <name>Update_Resultado_Valida</name>
            <type>FieldUpdate</type>
        </action>
        <action>
            <name>Update_SubEstado</name>
            <type>FieldUpdate</type>
        </action>
    </finalRejectionActions>
    <finalRejectionRecordLock>false</finalRejectionRecordLock>
    <label>Aprobación de Candidatos por Legal</label>
    <processOrder>2</processOrder>
    <recordEditability>AdminOrCurrentApprover</recordEditability>
    <showApprovalHistory>true</showApprovalHistory>
</ApprovalProcess>
