<?xml version="1.0" encoding="UTF-8"?>
<ApprovalProcess xmlns="http://soap.sforce.com/2006/04/metadata">
    <active>true</active>
    <allowRecall>false</allowRecall>
    <allowedSubmitters>
        <type>owner</type>
    </allowedSubmitters>
    <approvalPageFields>
        <field>Name</field>
        <field>Owner</field>
        <field>LEA_TipoIdentificacion__c</field>
        <field>LEA_NumIdentificacion__c</field>
        <field>LEA_RNC__c</field>
        <field>Status</field>
    </approvalPageFields>
    <approvalStep>
        <allowDelegate>false</allowDelegate>
        <approvalActions>
            <action>
                <name>Tec_Update_Estado_Aprobado</name>
                <type>FieldUpdate</type>
            </action>
            <action>
                <name>Tec_Update_Validacion_Completada</name>
                <type>FieldUpdate</type>
            </action>
        </approvalActions>
        <assignedApprover>
            <approver>
                <name>FSC_Cola_Tecnologia</name>
                <type>queue</type>
            </approver>
            <whenMultipleApprovers>FirstResponse</whenMultipleApprovers>
        </assignedApprover>
        <label>Revision Tecnologia</label>
        <name>Revision_Tecnologia</name>
        <rejectionActions>
            <action>
                <name>Tec_Update_Estado_Rechazado</name>
                <type>FieldUpdate</type>
            </action>
            <action>
                <name>Tec_Update_Status_Iniciado</name>
                <type>FieldUpdate</type>
            </action>
        </rejectionActions>
    </approvalStep>
    <emailTemplate>all/Plantilla_de_Aprobacion</emailTemplate>
    <enableMobileDeviceAccess>false</enableMobileDeviceAccess>
    <finalApprovalRecordLock>false</finalApprovalRecordLock>
    <finalRejectionRecordLock>false</finalRejectionRecordLock>
    <initialSubmissionActions>
        <action>
            <name>Tec_Update_Estado_Pendiente</name>
            <type>FieldUpdate</type>
        </action>
    </initialSubmissionActions>
    <label>PA Aprobacion Tecnologia LEAD</label>
    <processOrder>3</processOrder>
    <recordEditability>AdminOrCurrentApprover</recordEditability>
    <showApprovalHistory>true</showApprovalHistory>
</ApprovalProcess>
