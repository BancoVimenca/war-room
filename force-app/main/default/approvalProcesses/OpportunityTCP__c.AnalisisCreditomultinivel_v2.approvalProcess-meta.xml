<?xml version="1.0" encoding="UTF-8"?>
<ApprovalProcess xmlns="http://soap.sforce.com/2006/04/metadata">
    <active>true</active>
    <allowRecall>false</allowRecall>
    <allowedSubmitters>
        <submitter>SUBGERENTE_DE_CREDITO</submitter>
        <type>roleSubordinatesInternal</type>
    </allowedSubmitters>
    <approvalPageFields>
        <field>Name</field>
        <field>Owner</field>
    </approvalPageFields>
    <approvalStep>
        <allowDelegate>false</allowDelegate>
        <assignedApprover>
            <approver>
                <name>SUB_GERENTES_DE_CREDITO</name>
                <type>queue</type>
            </approver>
            <approver>
                <name>OTCP_AssignedAnalyst__c</name>
                <type>relatedUserField</type>
            </approver>
            <whenMultipleApprovers>Unanimous</whenMultipleApprovers>
        </assignedApprover>
        <description>El analista aprueba o rechaza si el Monto es de 0 hasta 350.000</description>
        <entryCriteria>
            <criteriaItems>
                <field>OpportunityTCP__c.OTCP_PreApprovedAmount__c</field>
                <operation>lessOrEqual</operation>
                <value>350000</value>
            </criteriaItems>
        </entryCriteria>
        <ifCriteriaNotMet>GotoNextStep</ifCriteriaNotMet>
        <label>Nivel 1 - Aprueba Analista y subgerente</label>
        <name>Nivel_1_Aprueba_Analista</name>
    </approvalStep>
    <approvalStep>
        <allowDelegate>false</allowDelegate>
        <assignedApprover>
            <approver>
                <name>GERENTES_DE_CR_DITO</name>
                <type>queue</type>
            </approver>
            <approver>
                <name>SUB_GERENTES_DE_CREDITO</name>
                <type>queue</type>
            </approver>
            <whenMultipleApprovers>Unanimous</whenMultipleApprovers>
        </assignedApprover>
        <description>El subgerente y gerente puede aprobar o rechazar si el (monto &gt;= 350001 AND monto &lt;= 1000000)</description>
        <entryCriteria>
            <criteriaItems>
                <field>OpportunityTCP__c.OTCP_PreApprovedAmount__c</field>
                <operation>greaterOrEqual</operation>
                <value>350001</value>
            </criteriaItems>
            <criteriaItems>
                <field>OpportunityTCP__c.OTCP_PreApprovedAmount__c</field>
                <operation>lessOrEqual</operation>
                <value>1000000</value>
            </criteriaItems>
        </entryCriteria>
        <label>Nivel 2 - Aprueba Subgerente y Gerente</label>
        <name>Nivel_2_Aprueba_Subgerente_y_Gerente</name>
        <rejectBehavior>
            <type>RejectRequest</type>
        </rejectBehavior>
    </approvalStep>
    <enableMobileDeviceAccess>false</enableMobileDeviceAccess>
    <entryCriteria>
        <booleanFilter>1 AND 2 AND 3 AND 4 AND 5 AND 6</booleanFilter>
        <criteriaItems>
            <field>OpportunityTCP__c.RecordType</field>
            <operation>equals</operation>
            <value>Solicitud TC Preembosada</value>
        </criteriaItems>
        <criteriaItems>
            <field>OpportunityTCP__c.OTCP_State__c</field>
            <operation>equals</operation>
            <value>Analisis de Credito</value>
        </criteriaItems>
        <criteriaItems>
            <field>OpportunityTCP__c.OTCP_SubState__c</field>
            <operation>equals</operation>
            <value>Pendiente Analisis de credito</value>
        </criteriaItems>
        <criteriaItems>
            <field>OpportunityTCP__c.OTCP_AssignedAnalyst__c</field>
            <operation>notEqual</operation>
        </criteriaItems>
        <criteriaItems>
            <field>OpportunityTCP__c.OTCP_PreApprovedAmount__c</field>
            <operation>greaterThan</operation>
            <value>0</value>
        </criteriaItems>
        <criteriaItems>
            <field>OpportunityTCP__c.OTCP_AnalysisInitiated__c</field>
            <operation>equals</operation>
            <value>SI</value>
        </criteriaItems>
    </entryCriteria>
    <finalApprovalActions>
        <action>
            <name>Update_EnAprobacionAnalisisFALSE</name>
            <type>FieldUpdate</type>
        </action>
        <action>
            <name>Update_Estado_Aprobado</name>
            <type>FieldUpdate</type>
        </action>
        <action>
            <name>Update_MontoAprobado</name>
            <type>FieldUpdate</type>
        </action>
        <action>
            <name>Update_RetrasoAnalisisNotifFALSEAprobado</name>
            <type>FieldUpdate</type>
        </action>
        <action>
            <name>Update_subEstado_null</name>
            <type>FieldUpdate</type>
        </action>
        <action>
            <name>Update_UltimaInteraccionAhoraAprobado</name>
            <type>FieldUpdate</type>
        </action>
    </finalApprovalActions>
    <finalApprovalRecordLock>false</finalApprovalRecordLock>
    <finalRejectionActions>
        <action>
            <name>Update_EnAprobacionFALSERechazo</name>
            <type>FieldUpdate</type>
        </action>
        <action>
            <name>Update_Estado_Cerrada_perdida</name>
            <type>FieldUpdate</type>
        </action>
        <action>
            <name>Update_Retraso_notif_FALSE_Rechazo</name>
            <type>FieldUpdate</type>
        </action>
        <action>
            <name>Update_Sub_estado_Rechazada</name>
            <type>FieldUpdate</type>
        </action>
        <action>
            <name>Update_UltimaInteraccionAhoraRechazo</name>
            <type>FieldUpdate</type>
        </action>
    </finalRejectionActions>
    <finalRejectionRecordLock>false</finalRejectionRecordLock>
    <initialSubmissionActions>
        <action>
            <name>Update_EnAprobacionAnalisisTRUE</name>
            <type>FieldUpdate</type>
        </action>
        <action>
            <name>Update_Retraso_Analisis_notif_TRUE</name>
            <type>FieldUpdate</type>
        </action>
        <action>
            <name>Update_UltimaInteraccionAhora</name>
            <type>FieldUpdate</type>
        </action>
    </initialSubmissionActions>
    <label>Análisis de Crédito multinivel_v2</label>
    <processOrder>1</processOrder>
    <recordEditability>AdminOnly</recordEditability>
    <showApprovalHistory>true</showApprovalHistory>
</ApprovalProcess>
