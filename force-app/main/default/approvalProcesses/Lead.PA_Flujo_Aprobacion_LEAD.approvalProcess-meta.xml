<?xml version="1.0" encoding="UTF-8"?>
<ApprovalProcess xmlns="http://soap.sforce.com/2006/04/metadata">
    <active>true</active>
    <allowRecall>false</allowRecall>
    <allowedSubmitters>
        <type>owner</type>
    </allowedSubmitters>
    <approvalPageFields>
        <field>Name</field>
        <field>Company</field>
        <field>LEA_RNC__c</field>
        <field>Status</field>
        <field>LEA_SubEstado__c</field>
        <field>LEA_Link_Candidato__c</field>
        <field>Owner</field>
    </approvalPageFields>
    <approvalStep>
        <allowDelegate>false</allowDelegate>
        <approvalActions>
            <action>
                <name>Update_Estado</name>
                <type>FieldUpdate</type>
            </action>
            <action>
                <name>Update_Fecha</name>
                <type>FieldUpdate</type>
            </action>
            <action>
                <name>Update_Resultado_Valida2</name>
                <type>FieldUpdate</type>
            </action>
            <action>
                <name>Update_Subestado1</name>
                <type>FieldUpdate</type>
            </action>
            <action>
                <name>Update_Validado</name>
                <type>FieldUpdate</type>
            </action>
        </approvalActions>
        <assignedApprover>
            <approver>
                <name>FSC_Legal</name>
                <type>queue</type>
            </approver>
            <whenMultipleApprovers>FirstResponse</whenMultipleApprovers>
        </assignedApprover>
        <label>Peticion de Aprobacion</label>
        <name>Peticion_de_Aprobacion</name>
        <rejectionActions>
            <action>
                <name>Update_Estado2</name>
                <type>FieldUpdate</type>
            </action>
            <action>
                <name>Update_Resultado_Valida</name>
                <type>FieldUpdate</type>
            </action>
            <action>
                <name>Update_SubEstado</name>
                <type>FieldUpdate</type>
            </action>
        </rejectionActions>
    </approvalStep>
    <emailTemplate>all/Plantilla_de_Aprobacion</emailTemplate>
    <enableMobileDeviceAccess>false</enableMobileDeviceAccess>
    <entryCriteria>
        <criteriaItems>
            <field>Lead.Status</field>
            <operation>equals</operation>
            <value>VALIDADO</value>
        </criteriaItems>
        <criteriaItems>
            <field>Lead.LEA_SubEstado__c</field>
            <operation>equals</operation>
            <value>EN REVISIÓN</value>
        </criteriaItems>
    </entryCriteria>
    <finalApprovalRecordLock>true</finalApprovalRecordLock>
    <finalRejectionRecordLock>false</finalRejectionRecordLock>
    <label>PA Flujo Aprobacion  LEAD</label>
    <processOrder>1</processOrder>
    <recordEditability>AdminOnly</recordEditability>
    <showApprovalHistory>true</showApprovalHistory>
</ApprovalProcess>
