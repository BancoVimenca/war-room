<?xml version="1.0" encoding="UTF-8"?>
<ValidationRule xmlns="http://soap.sforce.com/2006/04/metadata">
    <fullName>VR_FechaFinLaboralNoAnteriorIngreso</fullName>
    <active>true</active>
    <description>Impide que la fecha de fin laboral sea anterior a la fecha de ingreso.</description>
    <errorConditionFormula>AND(
    NOT(ISBLANK(LEA_Fecha_de_ingreso__c)),
    NOT(ISBLANK(LEA_Fecha_de_fin__c)),
    LEA_Fecha_de_fin__c &lt; LEA_Fecha_de_ingreso__c
)</errorConditionFormula>
    <errorDisplayField>LEA_Fecha_de_fin__c</errorDisplayField>
    <errorMessage>La fecha de fin no puede ser anterior a la fecha de ingreso.</errorMessage>
</ValidationRule>
