<?xml version="1.0" encoding="UTF-8"?>
<ValidationRule xmlns="http://soap.sforce.com/2006/04/metadata">
    <fullName>VR_VinculacionyPrevencion</fullName>
    <active>true</active>
    <errorConditionFormula>AND(
IsConverted = TRUE,
NOT(PRIORVALUE(IsConverted)),
NOT(LEA_Vinculacion_Prevencion__c)
)</errorConditionFormula>
    <errorDisplayField>LEA_Vinculacion_Prevencion__c</errorDisplayField>
    <errorMessage>Debe chequear el campo Vinculacion y Prevencion para convertir</errorMessage>
</ValidationRule>
